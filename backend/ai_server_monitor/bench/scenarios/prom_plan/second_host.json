{
 "id": "prom_plan.second_host",
 "group": "prom_plan",
 "title": "A second machine in the same Prometheus",
 "description": "Prometheus also scrapes a NAS (10.20.30.40) and a Windows PC (10.20.30.50:9182) next to the monitored server. The planner tells the model that a job scraping ANOTHER machine must keep the instance label in the result. Queries must stay job-scoped so they do not mix the machines, counters must be rated, and the Windows job needs its own windows_* metrics, not node_*. Tests that the model respects the job boundary on a multi-host Prometheus.",
 "snapshot": "base",
 "input": {
  "kind": "prom_plan",
  "catalog": {
   "jobs": [
    {
     "job": "node",
     "targets": [
      {
       "instance": "node-exporter:9100",
       "health": "up"
      }
     ],
     "metrics": {
      "node_load5": {
       "type": "gauge",
       "help": "5m load average.",
       "value": 1.52
      },
      "node_pressure_cpu_waiting_seconds_total": {
       "type": "counter",
       "help": "Total time processes waited for CPU",
       "value": 5120.4
      },
      "node_pressure_memory_waiting_seconds_total": {
       "type": "counter",
       "help": "Total time processes waited for memory",
       "value": 88.1
      },
      "node_pressure_io_waiting_seconds_total": {
       "type": "counter",
       "help": "Total time processes waited for IO",
       "value": 301.2
      },
      "node_network_receive_errs_total": {
       "type": "counter",
       "help": "Network device statistic receive_errs.",
       "series": 3,
       "value": 0
      },
      "node_network_transmit_drop_total": {
       "type": "counter",
       "help": "Network device statistic transmit_drop.",
       "series": 3,
       "value": 0
      },
      "node_disk_io_time_seconds_total": {
       "type": "counter",
       "help": "Total seconds spent doing I/Os.",
       "series": 6,
       "value": 4021.7
      },
      "node_hwmon_temp_celsius": {
       "type": "gauge",
       "help": "Hardware monitor for temperature",
       "series": 8,
       "value": 48.0
      },
      "node_filesystem_files_free": {
       "type": "gauge",
       "help": "Filesystem total free file nodes.",
       "series": 12,
       "value": 61234123
      },
      "node_memory_Shmem_bytes": {
       "type": "gauge",
       "help": "Memory information field Shmem_bytes.",
       "value": 812000000
      }
     }
    },
    {
     "job": "node-nas",
     "targets": [
      {
       "instance": "10.20.30.40:9100",
       "health": "up"
      }
     ],
     "metrics": {
      "node_load5": {
       "type": "gauge",
       "help": "5m load average.",
       "value": 0.4
      },
      "node_filesystem_avail_bytes": {
       "type": "gauge",
       "help": "Filesystem space available to non-root users in bytes.",
       "series": 4,
       "value": 3100000000000
      },
      "node_filesystem_size_bytes": {
       "type": "gauge",
       "help": "Filesystem size in bytes.",
       "series": 4,
       "value": 8000000000000
      },
      "node_disk_io_time_seconds_total": {
       "type": "counter",
       "help": "Total seconds spent doing I/Os.",
       "series": 4,
       "value": 90210.5
      },
      "node_hwmon_temp_celsius": {
       "type": "gauge",
       "help": "Hardware monitor for temperature",
       "series": 6,
       "value": 41.0
      },
      "node_network_receive_errs_total": {
       "type": "counter",
       "help": "Network device statistic receive_errs.",
       "series": 2,
       "value": 0
      }
     }
    },
    {
     "job": "windows-pc",
     "targets": [
      {
       "instance": "10.20.30.50:9182",
       "health": "up"
      }
     ],
     "metrics": {
      "windows_cpu_time_total": {
       "type": "counter",
       "help": "Time that processor spent in different modes (idle, user, system, ...)",
       "series": 16,
       "value": 99120.0
      },
      "windows_memory_available_bytes": {
       "type": "gauge",
       "help": "The amount of physical memory immediately available",
       "value": 9000000000
      },
      "windows_logical_disk_free_bytes": {
       "type": "gauge",
       "help": "Free space in bytes",
       "series": 3,
       "value": 210000000000
      },
      "windows_net_packets_received_errors_total": {
       "type": "counter",
       "help": "Total number of received packets that contain errors",
       "series": 2,
       "value": 0
      }
     }
    }
   ]
  }
 },
 "checks": [
  {
   "type": "prom_queries_valid",
   "weight": 3,
   "min": 7
  },
  {
   "type": "prom_job_scoped",
   "weight": 3
  },
  {
   "type": "prom_counters_rated",
   "weight": 3
  }
 ],
 "judge": {
  "rubric": "Queries for node-nas and windows-pc are scoped to their own job, keep the instance label (no aggregation that drops it for per-machine questions), use windows_* names for the Windows host, and rate() on every counter. No query mixes metrics across jobs."
 },
 "tags": [
  "promql",
  "multi-host"
 ]
}
