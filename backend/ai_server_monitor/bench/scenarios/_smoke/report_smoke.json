{
 "id": "report.smoke_disk",
 "group": "report",
 "title": "Smoke: report on a nearly full disk",
 "description": "Smoke test for the benchmark itself: the root disk is at 91 % and one unit failed; a report must be valid, not ok, and name both.",
 "snapshot": "smoke",
 "input": {
  "kind": "report"
 },
 "checks": [
  {
   "type": "report_json_valid"
  },
  {
   "type": "report_health",
   "in": [
    "warn",
    "crit"
   ]
  },
  {
   "type": "report_findings_mention",
   "patterns": [
    "disk|filesystem|/ ",
    "logrotate"
   ],
   "min": 2
  },
  {
   "type": "report_no_invented",
   "patterns": [
    "radarr.*(down|failed|unhealthy)"
   ]
  }
 ]
}